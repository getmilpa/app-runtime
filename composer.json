{
  "name": "milpa/app-runtime",
  "description": "The agent runtime a Milpa app INSTALLS instead of copying: session gate, sub-agent delegation, tree budget, sterile-loop guard and the live bridge. Lives here so an existing app receives its improvements \u2014 a template that copies what nobody edits is a package in disguise.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://x.com/rodrigoteamx"
    }
  ],
  "require": {
    "milpa/agent": "^0.5",
    "milpa/ai-gateway": "^0.8",
    "milpa/command": "^0.5",
    "milpa/console": "^0.7",
    "milpa/core": "^0.6.2 || ^0.7",
    "milpa/event-store": "^0.1",
    "php": "^8.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/phpdoc-parser": "^2.3",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\AppRuntime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\AppRuntime\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
